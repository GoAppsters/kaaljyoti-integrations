{
  "name": "@kaaljyoti/sdk",
  "author": "GoAppsters (https://goappsters.in)",
  "version": "0.1.0",
  "description": "Typed TypeScript/Node client for the Kaal Jyoti API: kundli, panchang, dasha, transits, matching and more.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goappsters/kaaljyoti-integrations.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://kaaljyoti.com/api/docs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "KJ_SMOKE=1 vitest run test/smoke.test.ts"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "astrology",
    "vedic",
    "kundli",
    "panchang",
    "jyotish",
    "kaaljyoti",
    "api",
    "sdk"
  ]
}
