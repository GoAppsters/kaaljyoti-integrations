{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kaal-jyoti/muhurta",
  "title": "Kaal Jyoti Muhurta",
  "category": "widgets",
  "icon": "clock",
  "description": "The day's choghadiya and windows for a place: the sixteen choghadiyas, rahu kaal, yamaganda, gulika kaal and abhijit on a timeline, with a Day / Night table. One call. The preview in this editor calls the Kaal Jyoti API, exactly as the published page will.",
  "keywords": ["muhurta", "rahu kaal", "abhijit", "panchang", "jyotish"],
  "textdomain": "kaal-jyoti",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "city": {
      "type": "string",
      "default": ""
    },
    "lat": {
      "type": "string",
      "default": ""
    },
    "lon": {
      "type": "string",
      "default": ""
    },
    "timezone": {
      "type": "string",
      "default": ""
    },
    "place": {
      "type": "string",
      "default": ""
    },
    "date": {
      "type": "string",
      "default": ""
    },
    "lang": {
      "type": "string",
      "default": ""
    },
    "show": {
      "type": "string",
      "default": ""
    },
    "powered-by": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "preset": {
      "type": "string",
      "default": ""
    },
    "font": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js"
}
