{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kaal-jyoti/kundli-form",
  "title": "Kaal Jyoti Kundli Form",
  "category": "widgets",
  "icon": "forms",
  "description": "A birth form that opens a tabbed report of a visitor's kundli, and optionally their readings: lagna and nakshatra, and the personal ones (house lords, grahas, yogas, Vimshottari dashas, varshphal, life areas). Always rendered in the browser, and the preview in this editor calls the Kaal Jyoti API only once a birth is submitted: three calls (7 credits) for the overview, more as each other tab is first opened, and one per reading (5 credits each).",
  "keywords": ["kundli", "birth chart", "form", "horoscope", "jyotish"],
  "textdomain": "kaal-jyoti",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "show": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "chart-style": {
      "type": "string",
      "default": ""
    },
    "size": {
      "type": "string",
      "default": ""
    },
    "varga": {
      "type": "string",
      "default": ""
    },
    "readings": {
      "type": "string",
      "default": ""
    },
    "lang": {
      "type": "string",
      "default": ""
    },
    "disclaimer": {
      "type": "string",
      "default": ""
    },
    "disclaimer-name": {
      "type": "string",
      "default": ""
    },
    "disclaimer-url": {
      "type": "string",
      "default": ""
    },
    "powered-by": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "tabs": {
      "type": "string",
      "default": ""
    },
    "time-format": {
      "type": "string",
      "default": ""
    },
    "remember": {
      "type": "string",
      "default": ""
    },
    "pdf": {
      "type": "string",
      "default": ""
    },
    "preset": {
      "type": "string",
      "default": ""
    },
    "font": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "sign-icons": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js"
}
