{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kaal-jyoti/chart",
  "title": "Kaal Jyoti Chart",
  "category": "widgets",
  "icon": "grid-view",
  "description": "A drawn kundli for one birth. The preview in this editor calls the Kaal Jyoti API, exactly as the published page will.",
  "keywords": ["kundli", "chart", "horoscope", "varga", "jyotish"],
  "textdomain": "kaal-jyoti",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "datetime": {
      "type": "string",
      "default": ""
    },
    "timezone": {
      "type": "string",
      "default": ""
    },
    "lat": {
      "type": "string",
      "default": ""
    },
    "lon": {
      "type": "string",
      "default": ""
    },
    "place": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "chart-style": {
      "type": "string",
      "default": ""
    },
    "size": {
      "type": "string",
      "default": ""
    },
    "varga": {
      "type": "string",
      "default": ""
    },
    "show-degrees": {
      "type": "string",
      "default": ""
    },
    "lang": {
      "type": "string",
      "default": ""
    },
    "powered-by": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "preset": {
      "type": "string",
      "default": ""
    },
    "font": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js"
}
