{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kaal-jyoti/match-form",
  "title": "Kaal Jyoti Match (Ashtakoot)",
  "category": "widgets",
  "icon": "heart",
  "description": "Two birth forms, bride and groom, that score an Ashtakoot match out of 36 with the eight kootas and mangal dosha. Always rendered in the browser; the preview in this editor calls the Kaal Jyoti API only when a match is submitted: three calls per submit, the match and one kundli per person.",
  "keywords": ["match", "ashtakoot", "guna milan", "kundli milan", "compatibility", "jyotish"],
  "textdomain": "kaaljyoti",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "city": {
      "type": "string",
      "default": ""
    },
    "lang": {
      "type": "string",
      "default": ""
    },
    "powered-by": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "time-format": {
      "type": "string",
      "default": ""
    },
    "remember": {
      "type": "string",
      "default": ""
    },
    "pdf": {
      "type": "string",
      "default": ""
    },
    "preset": {
      "type": "string",
      "default": ""
    },
    "font": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "sign-icons": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js"
}
